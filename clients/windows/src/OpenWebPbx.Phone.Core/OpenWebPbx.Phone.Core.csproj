<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

<ItemGroup><EmbeddedResource Include="../../../../resources/windows-phone/release-public.pem" LogicalName="OpenWebPbx.Phone.ReleasePublicKey.pem" /></ItemGroup>
<PropertyGroup Condition="'$(PhonePackageFixture)' == 'true'"><DefineConstants>$(DefineConstants);PHONE_PACKAGE_FIXTURE</DefineConstants><OutputPath>bin/package-fixture/$(Configuration)/</OutputPath><IntermediateOutputPath>obj/package-fixture/$(Configuration)/</IntermediateOutputPath></PropertyGroup>
<ItemGroup Condition="'$(PhonePackageFixture)' == 'true'"><EmbeddedResource Include="$(PhonePackageFixtureConfiguration)" LogicalName="OpenWebPbx.Phone.PackageFixture.json" /></ItemGroup><Target Name="RequirePackageFixtureConfiguration" BeforeTargets="CoreCompile" Condition="'$(PhonePackageFixture)' == 'true'"><Error Condition="!Exists('$(PhonePackageFixtureConfiguration)')" Text="A new owned hosted package fixture configuration is required." /></Target><PropertyGroup><DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes></PropertyGroup></Project>
