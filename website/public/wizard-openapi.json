{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenWeb PBX first-boot and Webhotel wizard API",
    "version": "1.0.0",
    "description": "Companion API for https://openwebpbx.com/wizard. Separate from the existing hosted tenant API. Only this route family permits exact Origin https://openwebpbx.com; no cookie authority or credentialed CORS. All JSON responses are no-store. POST bodies must be JSON objects <=16 KiB. See docs/webhotel-onboarding.md for exact P256 message bytes and image integration. Source implementation; provider template deployment and native qualification are separate."
  },
  "servers": [
    {
      "url": "https://call.openweb.co.za/api/v1/wizard"
    }
  ],
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "Image setup"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "wizardHealth",
        "summary": "Check setup availability",
        "description": "",
        "tags": [
          "Image setup"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful setup step",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "wizard",
                    "version",
                    "providers",
                    "verification_uri"
                  ],
                  "properties": {
                    "wizard": {
                      "type": "string"
                    },
                    "version": {
                      "const": 1
                    },
                    "providers": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "webhotel",
                          "debian"
                        ]
                      }
                    },
                    "verification_uri": {
                      "const": "https://openwebpbx.com/wizard"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Setup refusal, including rate limits. No tokens or verification codes are returned in errors.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/account/register": {
      "post": {
        "operationId": "wizardRegister",
        "summary": "Create an email-verified owner account",
        "description": "Queues a one-use email code through global SMTP. No PBX service is created by this route.",
        "tags": [
          "Account"
        ],
        "security": [],
        "responses": {
          "202": {
            "description": "Successful setup step",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Setup refusal, including rate limits. No tokens or verification codes are returned in errors.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenant_name",
                  "slug",
                  "email",
                  "password",
                  "accept_terms"
                ],
                "properties": {
                  "tenant_name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 120
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 40
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 72,
                    "format": "password"
                  },
                  "accept_terms": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/account/verify": {
      "post": {
        "operationId": "wizardVerify",
        "summary": "Confirm registration and obtain an owner token",
        "description": "Requires the emailed code and the original chosen password.",
        "tags": [
          "Account"
        ],
        "security": [],
        "responses": {
          "default": {
            "description": "Setup refusal, including rate limits. No tokens or verification codes are returned in errors.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "201": {
            "description": "Successful setup step",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountToken"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token",
                  "password"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "maxLength": 72
                  }
                }
              }
            }
          }
        }
      }
    },
