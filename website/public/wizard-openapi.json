    "/devices/poll": {
      "post": {
        "operationId": "wizardPollImage",
        "summary": "Poll only from the image with its private device credential",
        "description": "Before claim returns state only. After claim includes bootstrap owner UUID/nonce/proof bytes; after authorization includes the signed activation and completion nonce. Completed, unexpired grants permit device-based renewal without retaining owner credentials.",
        "tags": [
          "Image setup"
