    "/devices/authorize": {
      "post": {
        "operationId": "wizardAuthorizeImage",
        "summary": "Sign the challenge and obtain a local-instance activation",
        "description": "The challenge must belong to this pairing. Authority rechecks owner/email status, signature, exact HTTPS proof, local IDs, key, hostname and requested label. The installed PBX independently verifies the pinned RSA receipt before storing it.",
        "tags": [
          "Image setup"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Successful setup step",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
