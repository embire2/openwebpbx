                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device_code",
                  "hostname",
                  "signature"
                ],
                "properties": {
                  "device_code": {
                    "$ref": "#/components/schemas/DeviceCode"
                  },
                  "hostname": {
                    "type": "string",
                    "description": "Exact hostname assigned by the installed tenant-domain worker; collision suffixes must be preserved."
                  },
                  "signature": {
                    "$ref": "#/components/schemas/Signature"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{pairing_uuid}": {
      "get": {
        "operationId": "wizardSetupStatus",
        "summary": "Check progress as the original owner",
        "description": "Owner-scoped, read-only progress without the private device credential, signed activation, challenge nonce or public key.",
        "tags": [
          "Image setup"
        ],
        "security": [
          {
            "ownerBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful setup step",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Setup refusal, including rate limits. No tokens or verification codes are returned in errors.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "pairing_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Owner token obtained from email verification or login. Browser memory only. Never pass this to a guest image."
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "format": "uuid"
      },
      "DeviceCode": {
        "type": "string",
        "pattern": "^owpd_[a-f0-9]{64}$",
        "description": "Private image credential. Keep only in root-owned state; never put it in a browser URL or send it to an owner."
      },
      "UserCode": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{5}-?[A-Fa-f0-9]{5}$",
        "example": "ABCDE-12345"
      },
      "Signature": {
        "type": "string",
        "description": "Base64 DER ECDSA P-256 SHA256 signature. The exact signed bytes are documented in docs/webhotel-onboarding.md."
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "pairing_uuid": {
            "$ref": "#/components/schemas/Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "claimed",
              "bootstrap_pending",
              "dns_ready",
              "authorized",
              "complete",
              "revoked"
            ]
          },
          "provider": {
            "enum": [
              "webhotel",
              "debian"
            ]
          },
          "image_version": {
            "type": "string"
          },
          "server_address": {
            "type": "string",
            "description": "Public peer IP observed by the authority; forwarded headers are ignored."
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "server_host": {
            "type": [
              "string",
              "null"
            ]
          },
          "ready": {
            "type": "boolean"
          },
          "tenant_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present only after the fresh trusted tenant HTTPS proof passes."
          },
          "admin_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Activation": {
        "type": "object",
        "required": [
          "key_id",
          "algorithm",
          "payload",
          "signature"
        ],
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "const": "installation-2026-a"
          },
          "algorithm": {
            "const": "RS256"
          },
          "payload": {
            "type": "string",
            "description": "Base64url original signed JSON; do not reserialize before verifying."
          },
          "signature": {
            "type": "string",
            "description": "Base64url RSA3072 SHA256 signature."
          }
        }
      },
      "AccountToken": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Owner bearer credential. Browser memory only; do not pass to the server image."
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "tenant": {
            "type": "object"
          }
        }
      }
    }
  },
  "x-proof-protocol": {
    "encoding": "UTF-8; every message ends with a final newline; UUIDs lowercase and dashed; key hash SHA256 lowercase hex; ECDSA P256 SHA256 signature base64 DER",
    "bootstrap_signature": "openwebpbx-bootstrap-v1\n{nonce}\n{serverAddress}\n{keyHash}\n{bootstrapUuid}\n{accountTenantUuid}\n{localTenantUuid}\n{domainUuid}\n{label}\n",
    "bootstrap_http80_body": "openwebpbx-bootstrap-v1\n{nonce}\n{keyHash}\n{serverAddress}\n",
    "authority_signature": "openwebpbx-installation-v1\n{nonce}\n{canonicalServerHost}\n{keyHash}\n{accountTenantUuid}\n{localTenantUuid}\n{domainUuid}\n{label}\n",
    "canonical_or_tenant_https_body": "openwebpbx-instance-v1\n{nonce}\n{keyHash}\n{canonicalServerHost}\n",
    "completion_signature": "openwebpbx-complete-v1\n{completeNonce}\n{keyHash}\n{canonicalServerHost}\n{actualTenantHostname}\n{domainUuid}\n",
    "ownership_rule": "Publish only the fixed nonce path /.well-known/openwebpbx-instance/{nonce}. Authority is required before alias creation; completed browser readiness also requires a fresh tenant TLS proof and matching enabled registry ownership. No guest receives owner credentials."
  }
}
