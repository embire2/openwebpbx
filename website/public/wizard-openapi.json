    "/devices/bootstrap": {
      "post": {
        "operationId": "wizardBootstrapImage",
        "summary": "Prove the image identity and allocate its canonical DNS hostname",
        "description": "The custodian checks the P256 signature and exact public HTTP80 nonce proof before creating the immutable node DNS record. No provider secret is supplied by the user.",
        "tags": [
          "Image setup"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful setup step",
