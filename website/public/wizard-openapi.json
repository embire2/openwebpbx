    "/devices": {
      "post": {
        "operationId": "wizardStartImage",
        "summary": "Start a Webhotel or Debian first-boot session",
        "description": "Use the image public peer address; no proxy header or supplied address is trusted. Codes expire after30 minutes. An expired same-image code can rotate while preserving its claimed owner and DNS binding. Never include device_code in the browser link.",
        "tags": [
          "Image setup"
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Successful setup step",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pairing_uuid",
                    "device_code",
                    "user_code",
                    "verification_uri",
                    "verification_uri_complete",
                    "expires_at",
                    "poll_interval"
                  ],
                  "properties": {
                    "pairing_uuid": {
                      "$ref": "#/components/schemas/Id"
                    },
                    "device_code": {
                      "$ref": "#/components/schemas/DeviceCode"
                    },
                    "user_code": {
                      "$ref": "#/components/schemas/UserCode"
                    },
                    "verification_uri": {
                      "const": "https://openwebpbx.com/wizard"
                    },
                    "verification_uri_complete": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "poll_interval": {
                      "const": 5
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Setup refusal, including rate limits. No tokens or verification codes are returned in errors.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "image_version",
                  "public_key",
                  "local_tenant_uuid",
                  "domain_uuid"
                ],
                "properties": {
                  "provider": {
                    "enum": [
                      "webhotel",
                      "debian"
                    ]
                  },
                  "image_version": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "public_key": {
                    "type": "string",
                    "description": "Base64 SPKI DER P-256 public key."
                  },
                  "local_tenant_uuid": {
                    "$ref": "#/components/schemas/Id"
                  },
                  "domain_uuid": {
                    "$ref": "#/components/schemas/Id"
                  },
                  "bootstrap_uuid": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Optional installed v4 UUID. Defines the immutable node-UUID.openwebpbx.com canonical hostname."
                  }
                }
              }
            }
          }
        }
      }
    },
