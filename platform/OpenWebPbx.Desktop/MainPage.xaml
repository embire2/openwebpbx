<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenWebPbx_Desktop.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="235" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigate">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" IsSelected="True"/>
   <NavigationViewItem Content="Admin" Tag="admin" Icon="Contact"/>
   <NavigationViewItem Content="Queue Callbacks" Tag="callbacks" Icon="Phone"/>
   <NavigationViewItem Content="Hotel Services" Tag="hotel" Icon="World"/>
   <NavigationViewItem Content="Android App" Tag="mobile" Icon="CellPhone"/>
   <NavigationViewItem Content="Updates" Tag="updates" Icon="Download"/>
   <NavigationViewItem Content="Setup" Tag="setup" Icon="Setting"/>
  </NavigationView.MenuItems>
  <Grid Padding="28">
   <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="22" MaxWidth="900" HorizontalAlignment="Stretch">
     <TextBlock Text="Your phone system" Style="{StaticResource TitleTextBlockStyle}"/>
     <TextBlock Text="OpenWeb PBX 1.0.7" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <InfoBar x:Name="StatusBanner" IsOpen="True" IsClosable="False" Title="Checking this server" Message="Connecting to the OpenWeb PBX service." Severity="Informational"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
      <StackPanel Spacing="12">
       <TextBlock Text="Server" Style="{StaticResource SubtitleTextBlockStyle}"/>
       <TextBlock x:Name="ServerAddress" Text="Choose your PBX address in Setup." TextWrapping="Wrap"/>
       <TextBlock x:Name="ServiceDetails" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Open Admin" Click="OpenAdmin" Style="{StaticResource AccentButtonStyle}"/><Button Content="Refresh" Click="Refresh"/></StackPanel>
      </StackPanel>
     </Border>
     <InfoBar x:Name="UpdateBanner" IsOpen="True" IsClosable="False" Title="Updates on this Windows server" Message="Update status appears after the updater is installed." Severity="Informational"/>
     <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Maximum="100"/>
     <CommandBar Background="Transparent" DefaultLabelPosition="Right">
      <AppBarButton Icon="Download" Label="Manage updates" Click="OpenUpdates"/>
      <AppBarButton Icon="Refresh" Label="Refresh status" Click="Refresh"/>
     </CommandBar>
     <TextBlock Text="Manage users, phones and calls" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBlock Text="Sign in to Admin to manage your PBX, connect the Android app and check your phone providers. Queue callbacks and hotel wake-up calls continue when you close this window." TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer x:Name="SetupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="Setup" Style="{StaticResource TitleTextBlockStyle}"/>
     <TextBlock Text="Connect this manager to your PBX" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBox x:Name="AddressInput" Header="PBX address" PlaceholderText="https://your-pbx.example.com" MinWidth="300"/>
     <TextBlock Text="Use your PBX’s secure web address. Sign-in takes place in your browser; this app never stores your password." TextWrapping="Wrap"/>
     <Button Content="Save Address" Click="SaveAddress" Style="{StaticResource AccentButtonStyle}"/>
     <InfoBar x:Name="SetupMessage" IsOpen="False" IsClosable="True"/>
     <TextBlock Text="Install on this Windows Server" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0"/>
     <TextBlock Text="Install a new phone system on this server. Windows will ask for administrator access. Existing PBX installations are preserved." TextWrapping="Wrap"/>
     <StackPanel x:Name="InstallPanel" Spacing="12">
      <TextBox x:Name="InstallDomain" Header="Server name" Text="localhost"/>
      <TextBox x:Name="InstallEmail" Header="Administrator email" InputScope="EmailSmtpAddress"/>
      <PasswordBox x:Name="InstallPassword" Header="Administrator password" PasswordRevealMode="Peek"/>
      <ComboBox x:Name="CertificateChoice" Header="Secure connection" SelectedIndex="0" SelectionChanged="CertificateModeChanged" HorizontalAlignment="Stretch">
       <ComboBoxItem Content="Local setup certificate (this server only)"/>
       <ComboBoxItem Content="Use a certificate installed on this server"/>
      </ComboBox>
      <ComboBox x:Name="InstalledCertificate" Header="Installed certificate" DisplayMemberPath="Label" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
      <TextBlock Text="The local certificate is for setup on this computer. Use a trusted certificate for other computers and phones. Setup uses HTTPS port 8443." TextWrapping="Wrap"/>
      <Button x:Name="InstallButton" Content="Install OpenWeb PBX" Click="InstallServer" Style="{StaticResource AccentButtonStyle}"/>
      <ProgressRing x:Name="InstallProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="28" Height="28"/>
      <InfoBar x:Name="InstallMessage" IsOpen="False" IsClosable="False"/>
     </StackPanel>
     <TextBlock x:Name="InstallUnavailable" Text="Use the complete Windows download to install a new server." TextWrapping="Wrap" Visibility="Collapsed"/>
     <Button Content="Open Installation Folder" Click="OpenFolder"/>
     <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0"/>
     <TextBlock Text="Manage updates in the signed-in Admin page. Choose notifications, automatic downloads, or installation during a daily maintenance window. Updates wait for active calls and keep a private recovery backup. This manager reopens in your Windows session after installation." TextWrapping="Wrap"/>
     <HyperlinkButton Content="OpenWeb PBX releases" NavigateUri="https://github.com/embire2/openwebpbx/releases"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </NavigationView>
</Page>
