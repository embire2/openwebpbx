<include>
  <macro name="openweb_callback_intro"><input pattern="(.*)"><match><action function="play-file" data="$${sounds_dir}/openwebpbx/callback-intro.wav"/></match></input></macro>
  <macro name="openweb_callback_offer"><input pattern="(.*)"><match><action function="play-file" data="$${sounds_dir}/openwebpbx/callback-offer.wav"/></match></input></macro>
  <macro name="openweb_callback_saved"><input pattern="(.*)"><match><action function="play-file" data="$${sounds_dir}/openwebpbx/callback-saved.wav"/></match></input></macro>
  <macro name="openweb_wakeup"><input pattern="(.*)"><match><action function="play-file" data="$${sounds_dir}/openwebpbx/wakeup.wav"/></match></input></macro>
  <macro name="openweb_queue_position"><input pattern="([0-9]+)"><match><action function="play-file" data="ivr/ivr-you_are_number.wav"/><action function="say" data="$1" method="pronounced" type="number"/><action function="play-file" data="ivr/ivr-in_line.wav"/></match></input></macro>
  <macro name="openweb_queue_wait"><input pattern="([0-9]+)"><match><action function="play-file" data="ivr/ivr-estimated_hold_time.wav"/><action function="say" data="$1" method="pronounced" type="number"/><action function="play-file" data="time/minutes.wav"/></match></input></macro>
</include>
