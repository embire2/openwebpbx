[Unit]
Description=OpenWeb PBX encrypted instance backup worker
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/fusionpbx/config.conf
ConditionPathExists=!/var/lib/openwebpbx/updates/maintenance

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/openwebpbx/tools/backups.py worker
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run /var/backups/openwebpbx/automatic /var/lib/openwebpbx/backup-downloads
