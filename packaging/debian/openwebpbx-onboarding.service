# OpenWeb PBX managed installation registration v1
[Unit]
Description=OpenWeb PBX installation registration
After=network-online.target postgresql.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/openwebpbx/tools/onboarding.py --tick
TimeoutStartSec=20min
StandardOutput=journal+console
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
