# OpenWeb PBX managed STUN-only service, revision 1
[Unit]
Description=OpenWeb PBX UDP STUN binding service (no TURN relay)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/openwebpbx-stun.conf
[Service]
Type=simple
ExecStart=/usr/bin/turnserver -c /etc/openwebpbx-stun.conf --stun-only
DynamicUser=yes
User=openwebpbx-stun
RuntimeDirectory=openwebpbx-stun
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=5
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
[Install]
WantedBy=multi-user.target
