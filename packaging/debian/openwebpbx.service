[Unit]
Description=OpenWeb PBX callbacks and hotel wake-up calls
After=network.target postgresql.service freeswitch.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/openwebpbx/service
Environment=OPENWEBPBX_CONFIG=/etc/openwebpbx/runtime.json
ExecStart=/opt/openwebpbx/service/OpenWebPbx.Server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
