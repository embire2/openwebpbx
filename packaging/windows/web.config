<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <location path="app/pbx_protection/upload.php"><system.webServer><serverRuntime uploadReadAheadSize="0"/></system.webServer></location>
 <location path="api/v2"><system.webServer><serverRuntime uploadReadAheadSize="0"/></system.webServer></location>
 <system.webServer>
 <defaultDocument><files><clear/><add value="index.php"/></files></defaultDocument>
 <modules runAllManagedModulesForAllRequests="true"><add name="OpenWebPBX-UploadAdmission" type="OpenWebPbx.Windows.UploadAdmission, OpenWebPbx.UploadAdmission"/></modules>
 <handlers>
  <add name="OpenWeb-BackupStream" path="app/pbx_protection/upload.php" verb="POST" modules="FastCgiModule" scriptProcessor="C:\OpenWebPBX\php\php-cgi.exe|-c &quot;C:\ProgramData\OpenWebPBX\upload-admission\php.ini&quot;" resourceType="File" requireAccess="Script"/>
  <add name="OpenWeb-APIBackupStream" path="api/v2/upload.php" verb="POST" modules="FastCgiModule" scriptProcessor="C:\OpenWebPBX\php\php-cgi.exe|-c &quot;C:\ProgramData\OpenWebPBX\upload-admission\php.ini&quot;" resourceType="File" requireAccess="Script"/>
  <add name="OpenWeb-PHP" path="*.php" verb="GET,HEAD,POST,DELETE,OPTIONS" modules="FastCgiModule" scriptProcessor="C:\OpenWebPBX\php\php-cgi.exe" resourceType="File" requireAccess="Script"/>
 </handlers>
 <rewrite><rules>
  <rule name="OpenWebPBX Encrypted API Backup" stopProcessing="true">
   <match url="^api/v2/(instance/backups/import|tenants/[a-f0-9-]+/backups/import)$"/>
   <action type="Rewrite" url="api/v2/upload.php?route=/{R:1}" appendQueryString="true"/>
  </rule>
  <rule name="OpenWebPBX Administration API v2" stopProcessing="true">
   <match url="^api/v2/(?!index\.php$|upload\.php$)(.*)$"/>
   <action type="Rewrite" url="api/v2/index.php?route=/{R:1}" appendQueryString="true"/>
  </rule>
  <rule name="OpenWebPBX Tenant API v1" stopProcessing="true">
   <match url="^api/v1/(?!index\.php$)(.*)$"/>
   <action type="Rewrite" url="api/v1/index.php?route=/{R:1}" appendQueryString="true"/>
  </rule>
 </rules></rewrite>
 <security><requestFiltering>
  <requestLimits maxAllowedContentLength="2160066560"/>
  <hiddenSegments><add segment=".git"/><add segment=".env"/><add segment="tests"/><add segment="packaging"/><add segment="platform"/></hiddenSegments>
  <fileExtensions><add fileExtension=".conf" allowed="false"/><add fileExtension=".sql" allowed="false"/><add fileExtension=".lua" allowed="false"/><add fileExtension=".key" allowed="false"/><add fileExtension=".zip" allowed="false"/></fileExtensions>
 </requestFiltering></security>
 <httpProtocol><customHeaders><remove name="X-Powered-By"/><add name="X-Content-Type-Options" value="nosniff"/></customHeaders></httpProtocol>
 <httpErrors existingResponse="PassThrough"/>
</system.webServer></configuration>
